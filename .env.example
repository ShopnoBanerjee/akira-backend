# ---------------------------------------------------------------------------
# AKIRA Ops Suite — API environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# local | ci | staging | production
ENV=local

# --- Supabase -------------------------------------------------------------
# Auth and Storage only. Application data is read and written through
# DATABASE_URL, never through the Supabase REST API. See CLAUDE.md.
SUPABASE_URL=https://smbzzcjuflshjcmfeilp.supabase.co

# Safe to expose to the browser. Same value as the web app's publishable key.
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses RLS. Server-side only — never ships to the browser.
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_KEY=

# Used to verify incoming Supabase JWTs. Signature verification happens against
# this endpoint, with the key set cached and refreshed on a kid miss.
SUPABASE_JWT_JWKS_URL=https://smbzzcjuflshjcmfeilp.supabase.co/auth/v1/.well-known/jwks.json

# --- Database -------------------------------------------------------------
# Direct Postgres connection. Supabase dashboard -> Project Settings ->
# Database -> Connection string -> URI (use the session pooler for local dev).
# For the docker-compose Postgres instead:
#   postgresql+asyncpg://akira:akira@localhost:5432/akira_ops
DATABASE_URL=postgresql+asyncpg://akira:akira@localhost:5432/akira_ops

# --- Web ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Privacy --------------------------------------------------------------
# Salt for customer_phone_hash on ingested sales rows. Raw phone numbers are
# never persisted. Rotating this value orphans every existing hash.
PHONE_HASH_SALT=change-me-before-any-real-ingest
