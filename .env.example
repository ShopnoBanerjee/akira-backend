# ---------------------------------------------------------------------------
# AKIRA Ops Suite — API environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# local | ci | staging | production
#
# production is a contract, not a label. With ENV=production the API refuses
# to start unless every one of these holds (app/core/config.py,
# production_problems): DATABASE_URL, SUPABASE_URL, SUPABASE_SECRET_KEY and
# SUPABASE_JWKS_URL set and the JWKS URL under SUPABASE_URL; PHONE_HASH_SALT
# not a default and at least 24 characters; CORS_ORIGINS non-empty, https
# only, no localhost, no '*'; SQL_ECHO off; SMTP_FROM not a placeholder. The
# interactive /docs are also off in production.
ENV=local

# --- Supabase -------------------------------------------------------------
# Auth and Storage only. Application data is read and written through
# DATABASE_URL, never through the Supabase REST API. See CLAUDE.md.
SUPABASE_URL=https://zvskxgmmlahhybzpcicl.supabase.co

# Browser-safe by design. Same value as the web app's publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ySp9Uovntyxh9nJ-QuNm-Q_I40WS4y_

# SECRET. Bypasses RLS entirely. Server-side only — never ships to the browser
# and never appears in a commit.
# Supabase dashboard -> Project Settings -> API Keys -> secret key
SUPABASE_SECRET_KEY=

# Used to verify incoming Supabase JWTs. Signature verification happens against
# this endpoint, with the key set cached and refreshed on a kid miss.
SUPABASE_JWKS_URL=https://zvskxgmmlahhybzpcicl.supabase.co/auth/v1/.well-known/jwks.json

# --- Database -------------------------------------------------------------
# Direct Postgres connection. FastAPI owns every application read and write.
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# URI. Swap the postgresql:// scheme for postgresql+asyncpg://, and
# percent-encode any special characters in the password.
#
#   postgresql+asyncpg://postgres:<PASSWORD>@db.zvskxgmmlahhybzpcicl.supabase.co:5432/postgres
#
# NOTE: db.<ref>.supabase.co resolves to IPv6 ONLY. It works from a host with
# IPv6, but an IPv4-only environment (many CI runners and some PaaS) cannot
# reach it. Use the Supabase session pooler there instead - same credentials,
# different host and port, and it is IPv4-reachable.
#
# For the docker-compose Postgres instead:
#   postgresql+asyncpg://akira:akira@localhost:5433/akira_ops
DATABASE_URL=

# The pipeline's migration runner (scripts/migrate.py) reads this first, else
# DATABASE_URL. From GitHub it must be the Session pooler (IPv4, port 5432):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
MIGRATIONS_DATABASE_URL=

# Used by the migration tests, which apply the schema to a throwaway database.
# Point this at a local cluster, never at Supabase - the tests drop and
# recreate the database they run against.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# --- Web ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# Production: the deployed frontend's https origin(s), nothing else.
CORS_ORIGINS=http://localhost:5173

# Requests per minute per caller - the bearer token when there is one, the
# client address when there is not - as a token bucket that can burst to a
# whole minute's worth at once. Answers 429 problem+json with Retry-After.
# /healthz and /readyz are never limited. 0 disables it.
RATE_LIMIT_PER_MINUTE=600

# --- Privacy --------------------------------------------------------------
# Salt for customer_phone_hash on ingested sales rows. Raw phone numbers are
# never persisted. Rotating this value orphans every existing hash.
# Production refuses this placeholder and anything under 24 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_SALT=change-me-before-any-real-ingest

# --- Scheduled jobs -------------------------------------------------------
# In-process APScheduler. Exactly ONE instance may have this on: a second
# replica would double-materialise and double-send the digest.
SCHEDULER_ENABLED=true

# --- Outbound mail --------------------------------------------------------
# The daily digest. Leave SMTP_HOST empty and the notifier degrades to
# logging, recording "smtp_not_configured" in the job_runs row rather than
# silently sending nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AKIRA Ops <ops@akira.example>
SMTP_STARTTLS=true

# --- AI photo review ------------------------------------------------------
# Advisory only (docs/DECISIONS.md D6). Without a key, ai_review.enabled has
# nothing to call and the review records that rather than failing.
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-5

# Which transport answers: anthropic (SDK), gemini (native REST), or openai —
# ANY endpoint speaking the OpenAI chat-completions format (D28). The prompt is
# identical and the real model id is stored on every verdict, so rows from
# different providers never blur together.
AI_REVIEW_PROVIDER=anthropic

# --- Any OpenAI-compatible endpoint (D28) ---------------------------------
# Defaults to Gemini's compatibility layer, which reuses GEMINI_API_KEY and
# GEMINI_MODEL when these are blank — the zero-cost path. Point the base URL
# at https://openrouter.ai/api/v1 or a local http://localhost:11434/v1
# (Ollama) and set the key and model for that endpoint instead.
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
