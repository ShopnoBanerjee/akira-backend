# ---------------------------------------------------------------------------
# AKIRA Ops Suite — API environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# local | ci | staging | production
ENV=local

# --- Supabase -------------------------------------------------------------
# Auth and Storage only. Application data is read and written through
# DATABASE_URL, never through the Supabase REST API. See CLAUDE.md.
SUPABASE_URL=https://smbzzcjuflshjcmfeilp.supabase.co

# Browser-safe by design. Same value as the web app's publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_QODSb-Cdd6JVKyRQRELLMg_NIZxpFDi

# SECRET. Bypasses RLS entirely. Server-side only — never ships to the browser
# and never appears in a commit.
# Supabase dashboard -> Project Settings -> API Keys -> secret key
SUPABASE_SECRET_KEY=

# Used to verify incoming Supabase JWTs. Signature verification happens against
# this endpoint, with the key set cached and refreshed on a kid miss.
SUPABASE_JWKS_URL=https://smbzzcjuflshjcmfeilp.supabase.co/auth/v1/.well-known/jwks.json

# --- Database -------------------------------------------------------------
# Direct Postgres connection. FastAPI owns every application read and write.
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# URI. Swap the postgresql:// scheme for postgresql+asyncpg://, and
# percent-encode any special characters in the password.
#
#   postgresql+asyncpg://postgres:<PASSWORD>@db.smbzzcjuflshjcmfeilp.supabase.co:5432/postgres
#
# NOTE: db.<ref>.supabase.co resolves to IPv6 ONLY. It works from a host with
# IPv6, but an IPv4-only environment (many CI runners and some PaaS) cannot
# reach it. Use the Supabase session pooler there instead - same credentials,
# different host and port, and it is IPv4-reachable.
#
# For the docker-compose Postgres instead:
#   postgresql+asyncpg://akira:akira@localhost:5433/akira_ops
DATABASE_URL=

# Used by the migration tests, which apply the schema to a throwaway database.
# Point this at a local cluster, never at Supabase - the tests drop and
# recreate the database they run against.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# --- Web ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Privacy --------------------------------------------------------------
# Salt for customer_phone_hash on ingested sales rows. Raw phone numbers are
# never persisted. Rotating this value orphans every existing hash.
PHONE_HASH_SALT=change-me-before-any-real-ingest
